set -e

case "$1" in
    purge | remove)
        # 1. Clean up dynamically recorded files from install manifest if available
        MANIFEST="/var/lib/ot-extcap/manifest.list"
        if [ -f "$MANIFEST" ]; then
            while IFS= read -r FILE || [ -n "$FILE" ]; do
                if [ -n "$FILE" ] && [ -L "$FILE" ]; then
                    LINK_TARGET=$(readlink "$FILE")
                    if [ "$LINK_TARGET" = "/usr/bin/ot-extcap" ] || [ "$LINK_TARGET" = "/usr/local/bin/ot-extcap" ]; then
                        echo "Removing recorded ot-extcap symlink: $FILE"
                        rm -f "$FILE"
                    fi
                fi
            done <"$MANIFEST"
            rm -rf /var/lib/ot-extcap
        fi

        # 2. Fallback: query tshark and check standard paths in case manifest is missing
        # (e.g., upgrading or removing from an older version installed without manifest)
        EXTCAP_DIR=""
        if command -v tshark >/dev/null 2>&1; then
            # Run tshark -G folders and extract the Global Extcap path.
            # Try "Global Extcap path:" first, fallback to "Extcap path:" excluding "Personal".
            EXTCAP_DIR=$(tshark -G folders 2>/dev/null | grep -i "^Global Extcap path:" | sed -E 's/^.*[Ee]xtcap[[:space:]]+[Pp]ath:[[:space:]]*//' | xargs)
            if [ -z "$EXTCAP_DIR" ]; then
                EXTCAP_DIR=$(tshark -G folders 2>/dev/null | grep -i "Extcap path:" | grep -vi "Personal" | sed -E 's/^.*[Ee]xtcap[[:space:]]+[Pp]ath:[[:space:]]*//' | xargs)
            fi
        fi

        # Also check standard paths just in case
        for DIR in "$EXTCAP_DIR" "/usr/libexec/wireshark/extcap" "/usr/lib/x86_64-linux-gnu/wireshark/extcap" "/usr/lib/aarch64-linux-gnu/wireshark/extcap" "/usr/lib/arm-linux-gnueabihf/wireshark/extcap" "/usr/lib/wireshark/extcap"; do
            # CRITICAL: Do NOT use [ -f ] to check for the symlink because the binary has already been
            # deleted by dpkg before postrm runs, making this a broken symlink.
            # [ -f ] follows the link, sees the target is missing, and returns false, skipping it.
            # We must use [ -L ] directly to detect and remove the broken symlink.
            if [ -n "$DIR" ] && [ -L "$DIR/ot-extcap" ]; then
                # Double check it is indeed a symlink pointing to our binary
                LINK_TARGET=$(readlink "$DIR/ot-extcap")
                if [ "$LINK_TARGET" = "/usr/bin/ot-extcap" ] || [ "$LINK_TARGET" = "/usr/local/bin/ot-extcap" ]; then
                    echo "Removing ot-extcap symlink from: $DIR"
                    rm -f "$DIR/ot-extcap"
                fi
            fi
        done
        ;;

    upgrade | failed-upgrade | abort-install | abort-upgrade | disappear) ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
