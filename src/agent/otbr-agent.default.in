# Default settings for otbr-agent. This file is sourced by the service: systemd's
# EnvironmentFile, or the shell of the launchd job on macOS.

# Options to pass to otbr-agent
OTBR_AGENT_OPTS="-I @OTBR_THREAD_IF_NAME@ -B @OTBR_INFRA_IF_NAME@ @OTBR_RADIO_URL@ @OTBR_SERVICE_TREL_URL@"
OTBR_NO_AUTO_ATTACH=@OTBR_NO_AUTO_ATTACH@
